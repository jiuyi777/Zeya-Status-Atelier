tems:baseline;justify-content:space-between;gap:9px;font-size:33px;font-size:clamp(18px,8.5cqw,42px);font-weight:700;letter-spacing:.015em;line-height:1.18;margin-top:5px}\n.work-title-strip{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:12px 15px 13px;border-bottom:1.5px solid var(--rule)}\n.cover-title{min-width:0;flex:1;font-size:27px;letter-spacing:2px;line-height:1.5;overflow-wrap:anywhere}\n.cover-title.is-long{font-size:21px;letter-spacing:1px}\n.cover-subtitle{flex:0 1 38%;font-size:10px;line-height:1.8;text-align:right;color:var(--muted);letter-spacing:1px;overflow-wrap:anywhere}\n/* Compact marginal notes balance an open, uncropped illustration area. */\n.flower-plate{display:grid;grid-template-columns:63px minmax(0,1fr);column-gap:9px;padding:20px 15px 0;min-height:290px;align-items:end}\n.plate-notes{grid-column:1;grid-row:1;align-self:start;display:flex;flex-direction:column;align-items:flex-start;padding-top:1px;max-width:63px}\n.plate-note-heading{font:700 9px/1.5 Georgia,serif;letter-spacing:1.5px}\n.plate-note-number{font:italic 24px/1 Georgia,serif;color:var(--blue-ink);margin:14px 0 13px}\n.plate-color{display:flex;align-items:center;gap:5px;font-size:9px;line-height:1.8;color:var(--muted)}\n.plate-color i{width:6px;height:6px;background:var(--apricot)}\n.plate-color.blue i{background:#7e9d9e}\n.plate-note-small{font:9px/1.45 Georgia,serif;letter-spacing:.3px;margin-top:18px;color:var(--muted)}\n.hero-art{grid-column:2;grid-row:1;align-self:end;width:100%;height:auto;aspect-ratio:3/2;margin:34px 0 5px}\n.flower-plate figcaption{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;gap:12px;align-self:end;padding:16px 0 12px;font:7px/1.5 Georgia,serif;letter-spacing:1.2px;color:var(--muted)}\n.cover-navigation{display:grid;grid-template-columns:1fr 1fr;border-top:1.5px solid var(--rule)}\n.cover-link{display:flex;flex-direction:column;justify-content:center;min-height:80px;padding:12px 15px