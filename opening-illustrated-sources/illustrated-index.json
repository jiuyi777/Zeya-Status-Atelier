  "behavior": "(function apricotIndexRuntime(state, resolveRoute) {\n    const views = [...document.querySelectorAll('[data-view]')];\n    const viewed = new Set();\n    let route = {view:'home', index:null};\n    let previousHash = '#home';\n    const scrollPositions = new Map();\n    const setText = (selector, value) => document.querySelectorAll(selector).forEach(node => { node.textContent = value; });\n\n    function fillReader(index) {\n        const entry = state.entries[index];\n        if (!entry) return;\n        setText('[data-reader-title]', entry.title || '未命名开场');\n        setText('[data-reader-route]', entry.route || '未分类');\n        setText('[data-reader-number]', String(index + 1).padStart(2, '0'));\n        setText('[data-reader-text]', entry.previewText || entry.summary || '暂无开场内容');\n        const next = document.querySelector('[data-next-opening]');\n        next.hidden = index + 1 >= state.entries.length;\n        if (!next.hidden) next.setAttribute('href', '#opening/' + (index + 1));\n    }\n\n    function renderRoute(initial = false) {\n        const hash = window.location.hash || '#home';\n        scrollPositions.set(previousHash, window.scrollY);\n        const previous = route;\n        route = resolveRoute(hash, state.entries.length);\n        views.forEach(node => { node.hidden = node.dataset.view !== route.view; });\n        \n        if (route.view === 'reader') {\n            viewed.add(route.index);\n            fillReader(route.index);\n            setText('[data-read-count]', String(viewed.size).padStart(2, '0'));\n            document.querySelectorAll('[data-entry]').forEach(node => {\n                const seen = viewed.has(Number(node.dataset.entry));\n                node.classList.toggle('was-viewed', seen);\n                node.querySelector('[data-entry-status]').textContent = seen ? '再读一遍' : '翻开这一页';\n            });\n        }\n        const activeView = views.find(node => node.dataset.view === route.view);\n        const pageTitle = route.view === 'home' ? state.title : route.view === 'about' ? '作品资料' : route.view === 'openings' ? '选择开场' : state.entries[route.index].title;\n        document.title = (pageTitle || '开场白') + ' · 花间索引';\n        if (!initial) {\n            let focusTarget = activeView.querySelector('[data-page-heading]');\n            if (route.view === 'openings' && previous.view === 'reader') focusTarget = activeView.querySelector('[data-opening-index=\"' + previous.index + '\"]') || focusTarget;\n            if (route.view === 'home' && previous.view !== 'home') {\n                focusTarget = activeView.querySelector('[href=\"#' + (previous.view === 'about' ? 'about' : 'openings') + '\"]') || focusTarget;\n            }\n            focusTarget?.focus({preventScroll:true});\n            const isReturning = (route.view === 'home' && previous.view !== 'home') || (route.view === 'openings' && previous.view === 'reader');\n            window.scrollTo({top:isReturning ? scrollPositions.get(hash) || 0 : 0, behavior:'instant'});\n        }\n        previousHash = hash;\n    }\n\n    window.addEventListener('hashchange', () => renderRoute());\n    document.addEventListener('keydown', event => {\n        if (event.key !== 'Escape' || /INPUT|TEXTAREA|SELECT/.test(event.target.tagName) || event.target.isContentEditable) return;\n        if (route.view !== 'home') window.location.hash = route.view === 'reader' ? 'openings' : 'home';\n    });\n    document.querySelectorAll('[data-edit-home]').forEach(input => input.addEventListener('input', () => {\n        const key = input.dataset.editHome;\n        if (!Object.hasOwn(state, key) || key === 'entries') return;\n        state[key] = input.value;\n        document.querySelectorAll('[data-home]').forEach(node => {\n            if (node.dataset.home !== key) return;\n            node.textContent = input.value;\n            if (key === 'title') node.classList.toggle('is-long', Array.from(input.value).length > 6);\n        });\n        if (key === 'title') document.title = (input.value || '开场白') + ' · 花间索引';\n    }));\n    document.querySelectorAll('[data-edit-entry]').forEach(input => input.addEventListener('input', () => {\n        const index = Number(input.dataset.editEntry), key = input.dataset.editKey;\n        const entry = state.entries[index];\n        if (!entry || !['title', 'route', 'summary', 'previewText'].includes(key)) return;\n        entry[key] = input.value;\n        document.querySelectorAll('[data-entry=\"' + index + '\"] [data-entry-field=\"' + key + '\"]').forEach(node => { node.textContent = input.value; });\n        if (key === 'title') document.querySelector('[data-opening-index=\"' + index + '\"]').setAttribute('aria-label', '预览开场：' + input.value);\n        if (route.index === index) fillReader(index);\n    }));\n    renderRoute(true);\n})(___JIUYI_STATE___, function resolveOpeningRoute(hash, count) {\n    const path = String(hash || '').replace(/^#/, '');\n    if (path === 'about' || path === 'openings') return {view:path, index:null};\n    const match = /^opening\\/(0|[1-9]\\d*)$/.exec(path);\n    if (match && Number(match[1]) < count) return {view:'reader', index:Number(match[1])};\n    return {view:'home', index:null};\n});\n"
}
