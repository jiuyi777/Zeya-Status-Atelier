  "behavior": "(function editionRuntime(state, theme, editionName, resolveRoute) {\n    const app = document.querySelector('[data-edition]');\n    const views = [...document.querySelectorAll('[data-view]')];\n    const seen = new Set();\n    const positions = new Map();\n    const separatePages = theme === 'flight' || theme === 'botanical';\n    const directoryView = separatePages ? 'contents' : 'pages';\n    let lastCoverTarget = 'about';\n    let route = {view:theme === 'cobalt' ? 'pages' : 'cover', index:null};\n    const routeKey = current => current.view === 'reader' ? 'reader/'+current.index : current.view;\n    let previousKey = routeKey(resolveRoute(window.location.hash, state.entries.length, theme));\n    let openTimer = null;\n    const setText = (selector, value) => document.querySelectorAll(selector).forEach(node => {node.textContent=value;});\n\n    function cancelTransition() {\n        if (openTimer !== null) window.clearTimeout(openTimer);\n        openTimer = null;\n        app.classList.remove('is-opening');\n        app.classList.remove('is-opening-about');\n        app.classList.remove('is-opening-contents');\n    }\n    function fillReader(index) {\n        const entry = state.entries[index];\n        if (!entry) return;\n        setText('[data-reader-title]', entry.title || '未命名开场');\n        setText('[data-reader-route]', entry.route || '未分类');\n        setText('[data-reader-number]', String(index+1).padStart(2,'0'));\n        setText('[data-reader-text]', entry.previewText || entry.summary || '暂无开场内容');\n        const next = document.querySelector('[data-next-opening]');\n        next.hidden = index+1 >= state.entries.length;\n        if (next.hidden) next.removeAttribute('href');\n        else next.setAttribute('href', '#opening/'+(index+1));\n    }\n    function renderRoute(initial=false) {\n        cancelTransition();\n        const hash = window.location.hash || '#home';\n        positions.set(previousKey, window.scrollY);\n        const previous = route;\n        route = resolveRoute(hash, state.entries.length, theme);\n        if (separatePages && ['about','contents'].includes(route.view)) lastCoverTarget = route.view;\n        views.forEach(node => {node.hidden = node.dataset.view !== route.view;});\n        \n        if (route.view === 'reader') {\n            seen.add(route.index);\n            fillReader(route.index);\n            setText('[data-read-count]', String(seen.size).padStart(2,'0'));\n            document.querySelectorAll('[data-entry]').forEach(node => {\n                const isSeen = seen.has(Number(node.dataset.entry));\n                node.classList.toggle('was-viewed', isSeen);\n                node.querySelector('[data-entry-status]').textContent = isSeen ? '再读一遍' : '翻开';\n            });\n        }\n        const pageTitle = route.view === 'reader' ? state.entries[route.index].title || '未命名开场' : state.title || '开场白';\n        document.title = pageTitle+' · '+editionName;\n        if (!initial) {\n            const active = views.find(node => node.dataset.view === route.view);\n            let target = active.querySelector('[data-page-heading]');\n            if (route.view === directoryView && previous.view === 'reader') {\n                const entryNode = [...active.querySelectorAll('[data-entry]')].find(node => Number(node.dataset.entry) === previous.index);\n                const chapter = entryNode?.querySelector('[data-chapter]');\n                if (chapter) chapter.open = true;\n                target = [...active.querySelectorAll('[data-opening-index]')].find(node => Number(node.dataset.openingIndex) === previous.index) || target;\n            }\n            if (route.view === 'cover') target = separatePages\n                ? [...active.querySelectorAll('[data-open-cover]')].find(link => link.dataset.openCover === lastCoverTarget) || target\n                : active.querySelector('[data-open-cover]') || target;\n            target?.focus({preventScroll:true});\n            const returning = route.view === 'cover' || route.view === directoryView && previous.view === 'reader';\n            window.scrollTo({top:returning ? positions.get(routeKey(route)) || 0 : 0, behavior:'instant'});\n        }\n        previousKey = routeKey(route);\n    }\n    document.querySelectorAll('[data-open-cover]').forEach(link => link.addEventListener('click', event => {\n        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || route.view !== 'cover') return;\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n        event.preventDefault();\n        if (openTimer !== null) return;\n        const destination = link.getAttribute('href');\n        if (separatePages) {\n            lastCoverTarget = link.dataset.openCover;\n            app.classList.add('is-opening-'+lastCoverTarget);\n        }\n        app.classList.add('is-opening');\n        openTimer = window.setTimeout(() => {\n            openTimer = null;\n            window.location.hash = destination;\n        }, theme === 'flight' ? 680 : 560);\n    }));\n    window.addEventListener('hashchange', () => renderRoute());\n    document.addEventListener('keydown', event => {\n        if (event.key !== 'Escape' || /INPUT|TEXTAREA|SELECT/.test(event.target.tagName) || event.target.isContentEditable) return;\n        if (openTimer !== null) {cancelTransition();return;}\n        if (route.view === 'reader') window.location.hash = directoryView;\n        else if (['pages','about','contents'].includes(route.view) && theme !== 'cobalt') window.location.hash = 'home';\n    });\n    document.querySelectorAll('[data-edit-home]').forEach(input => input.addEventListener('input', () => {\n        const key=input.dataset.editHome;\n        if (!Object.hasOwn(state,key) || key==='entries') return;\n        state[key]=input.value;\n        document.querySelectorAll('[data-home]').forEach(node => {\n            if (node.dataset.home!==key) return;\n            node.textContent=input.value;\n            if (key==='title') node.classList.toggle('is-long',Array.from(input.value).length>6);\n        });\n        if (key==='title' && route.view!=='reader') document.title=(input.value||'开场白')+' · '+editionName;\n    }));\n    document.querySelectorAll('[data-edit-entry]').forEach(input => input.addEventListener('input', () => {\n        const index=Number(input.dataset.editEntry), key=input.dataset.editKey;\n        const entry=state.entries[index];\n        if (!entry || !['title','route','summary','previewText'].includes(key)) return;\n        entry[key]=input.value;\n        document.querySelectorAll('[data-entry]').forEach(node => {\n            if(Number(node.dataset.entry)!==index) return;\n            node.querySelectorAll('[data-entry-field]').forEach(field => {if(field.dataset.entryField===key)field.textContent=input.value;});\n            if(key==='title')node.querySelector('[data-opening-index]').setAttribute('aria-label','预览开场：'+input.value);\n        });\n        if (route.view==='reader' && route.index===index) {\n            fillReader(index);\n            if(key==='title')document.title=(input.value||'未命名开场')+' · '+editionName;\n        }\n    }));\n    renderRoute(true);\n})(___JIUYI_STATE___,\"botanical\",\"花笺序页\",function resolveEditionRoute(hash, count, theme) {\n    const path = String(hash || '').replace(/^#/, '');\n    const match = /^opening\\/(0|[1-9]\\d*)$/.exec(path);\n    if (match && Number(match[1]) < count) return {view:'reader', index:Number(match[1])};\n    if (theme === 'flight' || theme === 'botanical') {\n        if (path === 'about') return {view:'about', index:null};\n        if (path === 'contents' || path === 'pages') return {view:'contents', index:null};\n        return {view:'cover', index:null};\n    }\n    if (path === 'pages' || theme === 'cobalt') return {view:'pages', index:null};\n    return {view:'cover', index:null};\n});\n"
}
