y:grid;grid-template-columns:1fr 1fr;gap:12px}\n.editor-field{display:grid;gap:5px;min-width:0}\n.editor-field.wide{grid-column:1/-1}\n.editor-field input,.editor-field textarea{width:100%;min-width:0;color:var(--ink);background:var(--paper);border:1px solid var(--rule);border-radius:0;padding:9px;font-size:16px}\n.editor-field textarea{min-height:86px;resize:vertical}\n.editor-body h3{font:600 13px/1.5 system-ui,sans-serif;margin:20px 0 10px}\n.noscript-note{text-align:center;font:13px/1.8 system-ui,sans-serif;padding:20px}\n@media(max-width:480px){\n .home-shell{width:100%;margin:0 auto 24px}.cover-page{padding:22px 24px}.pages-view,.reader-view{padding:15px 22px 23px}\n .micro{font-size:8px;letter-spacing:1.4px}.cover-masthead{min-height:26px}.work-title{font-size:33px;letter-spacing:4px}.work-title.is-long{font-size:25px;letter-spacing:1.5px}\n .cover-subtitle,.page-subtitle{font-size:11px;letter-spacing:2px}.cover-colophon{font-size:10px;padding-top:20px}.cover-colophon .micro{font-size:7px;letter-spacing:1px}\n .page-topbar{font-size:11px}.page-topbar>.micro{font-size:7px;letter-spacing:1px}.pages-title{padding:22px 0}.credits{gap:12px;padding:17px 0}.credits dd{font-size:11px}.credits dt{font-size:9px;margin-bottom:4px}\n .story-intro{font-size:14px}.intro-column h2,.contents-header h2{font-size:24px}.entry-link h3{font-size:22px}.entry-summary{font-size:13px}.reader-text{font-size:16px;letter-spacing:.3px}.reader-heading h2{font-size:32px}\n .sample-editor{margin-inline:16px}.sample-caption{font-size:10px}\n}\n@media(max-width:350px){.cover-page{padding-inline:18px}.pages-view,.reader-view{padding-inline:18px}.credits{gap:8px}.credits dd{font-size:10px}.page-topbar>.micro{max-width:48%}.work-title{font-size:29px;letter-spacing:3px}}\n@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n\n.theme-botanical .edition{border:1px solid #dbdcd8}\n.theme-botanical .cover-page{padding-top:32px}\n.theme-botanical .cover-masthead .micro{font-size:8px;letter-spacing:2px;color:var(--muted)}\n.botanical-byline{text-align:center;font-size:11px;color:var(--muted);letter-spacing:2px;margin-top:25px}\n/* The two flower sections remain a single composition, with separate links. */\n.botanical-stage{--art-height:500px;--band-height:102px;position:relative;display:grid;grid-template-rows:auto auto auto;margin:24px auto 0;max-width:590px}\n.botanical-entrance{display:block;min-width:0;border-radius:10px;transition:transform .55s ease,opacity .5s}\n.botanical-half{position:relative;overflow:hidden;pointer-events:none}\n.half-top{height:calc(var(--art-height) * .52)}\n.half-bottom{height:calc(var(--art-height) * .48)}\n.botanical-illustration{position:absolute;left:0;top:0;width:100%;height:var(--art-height);max-width:none}\n.half-bottom .botanical-illustration{top:calc(var(--art-height) * -.52)}\n.botanical-entry-label{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:5px 15px;min-height:38px;padding:7px 4px;color:var(--ink);font-size:13px;letter-spacing:1px;text-align:center}\n.botanical-entry-label small{font:8px/1.6 Georgia,serif;letter-spacing:1.3px;color:var(--muted)}\n.botanical-entrance:hover .botanical-entry-label>span,.botanical-entrance:focus-visible .botanical-entry-label>span{text-decoration:underline;text-underline-offset:5px}\n.botanical-entrance:focus-visible{outline:2px solid var(--rule);outline-offset:4px}\n.title-band{position:relative;min-width:0;min-height:var(--band-height);border-block:2px solid var(--rule);display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--paper);padding:10px 12px;transition:opacity .45s;text-align:center}\n.title-band .work-title{max-width:100%;font-size:34px;letter-spacing:7px}.title-band .work-title.is-long{font-size:25px;letter-spacing:2px}\n.title-band .cover-subtitle{font-size:10px;letter-spacing:3px;margin-top:5px}\n.botanical-invitation{text-align:center;margin-top:24px;font-size:11px;line-height:1.9;letter-spacing:.6px;color:var(--muted)}\n.theme-botanical .cover-colophon{padding-top:24px}\n.theme-botanical .is-opening .bloom-about{transform:translateY(-42px);opacity:0}\n.theme-botanical .is-opening .bloom-contents{transform:translateY(42px);opacity:0}\n.theme-botanical .is-opening .title-band{opacity:0}\n\n/* Independent introduction and directory pages. */\n.theme-botanical .book-icon{width:21px;height:22px;flex:0 0 21px}\n.theme-botanical .page-topbar>a{gap:8px}\n.theme-botanical .pages-title{text-align:center;padding-top:29px;padding-bottom:25px;border-bottom-width:2px}\n.theme-botanical .credits{padding:20px 0 22px}\n.theme-botanical .about-layout,.theme-botanical .contents-layout{max-width:560px;margin-inline:auto;padding-top:28px}\n.theme-botanical .intro-column{padding:10px 0 24px}\n.theme-botanical .intro-column h2{font-size:23px}\n.theme-botanical .story-intro{max-width:40em;margin-top:17px;font-size:16px;line-height:2.1}\n.theme-botanical .contents-header{padding-bottom:18px;border-bottom:2px solid var(--rule)}\n.theme-botanical .contents-hint{font-size:12px;line-height:1.8;color:var(--muted);padding:13px 0 18px}\n.theme-botanical .section-switch{display:flex;align-items:center;gap:8px;min-height:44px;font-size:13px}\n.theme-botanical .edition-tail{flex-wrap:wrap;border-top-width:1.5px;margin-top:28px}\n\n/* Compact, rounded chapter cards retain the white paper palette. */\n.theme-botanical .opening-list{display:grid;gap:12px}\n.theme-botanical .opening-entry{border:0}\n.theme-botanical .chapter-sheet{border:1.5px solid #a4a89f;border-radius:12px;overflow:hidden;background:#fff}\n.theme-botanical .chapter-tab{position:relative;display:block;list-style:none;min-height:100px;padding:12px 16px 10px;cursor:pointer;overflow-wrap:anywhere}\n.theme-botanical .chapter-tab::-webkit-details-marker{display:none}\n.theme-botanical .chapter-tab:focus-visible{outline-offset:-5px;border-radius:10px}\n.t