  "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"author\" content=\"九一\"><title>___JIUYI_HOME_title___ · 靛蓝序章</title><style>@font-face{font-family:PrologueSong;src:url('___JIUYI_ASSET___5f912b8ae3c7967a7e4f.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap}\n:root{color-scheme:light;--paper:#eee9db;--ink:#34354e;--muted:#827967;--gold:#b5a783;--line:#9e926e50;font-family:PrologueSong,\"Noto Serif CJK SC\",\"Songti SC\",serif;font-synthesis:none}\n*{box-sizing:border-box}body{margin:0;background:#d7d3c9;color:var(--ink)}button,input,textarea{font:inherit}button{cursor:pointer}button,a{-webkit-tap-highlight-color:transparent}button:focus-visible,a:focus-visible,summary:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid #77709c;outline-offset:4px}button:active{transform:translateY(1px)}[hidden]{display:none!important}\n.home-shell{width:min(100%,560px);margin:0 auto;padding:0 0 26px}.book{background:var(--paper);box-shadow:0 12px 44px #413f3412;overflow:hidden}.book-cover{position:relative;isolation:isolate;aspect-ratio:2/3;display:grid;grid-template-columns:34% minmax(0,1fr);container-type:inline-size}.cover-art{position:absolute;inset:0;width:100%;height:100%;object-fit:fill;z-index:-1;user-select:none}.spine-label{position:absolute;left:17%;top:14%;writing-mode:vertical-rl;transform:translateX(-50%);font-family:Georgia,\"Times New Roman\",serif;font-size:clamp(9px,2.45cqw,13px);letter-spacing:.26em;color:#ddd3b4;max-height:40%}.cover-main{grid-column:2;min-width:0;padding:17% 14% 12% 16%;display:flex;flex-direction:column}.cover-topline{display:flex;justify-content:space-between;gap:10px;align-items:center;color:#8a7e61;font-size:12px}.cover-topline>span:first-child{font-family:Georgia,\"Times New Roman\",serif;font-size:10px;letter-spacing:.17em}.cover-heading{flex:1;display:flex;align-items:flex-start;gap:18px;padding:44px 0 24px;min-width:0}.cover-subtitle{writing-mode:vertical-rl;max-height:18em;max-width:2.6em;font-size:12px;line-height:1.9;letter-spacing:.1em;margin:38px 0 0;color:#827967;overflow-wrap:anywhere}.cover-title-box{flex:1;min-width:0;display:flex;justify-content:flex-end;align-items:flex-start;height:clamp(250px,68vw,375px)}.cover-title{writing-mode:vertical-rl;max-width:100%;height:100%;font-size:clamp(34px,10.8cqw,57px);font-weight:400;line-height:1.38;letter-spacing:.09em;margin:0;overflow-wrap:anywhere;color:#34354e}.cover-bottom{margin-top:10px}.cover-byline{font-size:12px;margin:0 0 20px;display:flex;gap:13px;align-items:baseline;flex-wrap:wrap;overflow-wrap:anywhere}.cover-byline>span:first-child{color:#98896b;font-size:10px}.cover-contents{display:flex;justify-content:space-between;align-items:center;gap:12px;border-top:1px solid #ac9d755c;padding-top:10px;min-height:48px;text-decoration:none;color:#454459;font-size:13px}.cover-contents>span:last-child{font-family:Georgia,serif;font-size:20px}.cover-contents:hover{color:#817352}\n.preface{display:grid;grid-template-columns:48px minmax(0,1fr);gap:20px;padding:38px 30px 32px;border-bottom:1px solid var(--line);background:#f3eee2}.margin-note{justify-self:start;writing-mode:vertical-rl;font-size:18px;letter-spacing:.35em;color:#a29571;padding-top:2px}.preface-body{min-width:0}.page-kicker{font-family:Georgia,\"Times New Roman\",serif;font-size:9px;letter-spacing:.15em;color:#98876a}.story-intro{font-size:14px;line-height:2;margin:16px 0 0;color:#655f55;overflow-wrap:anywhere}.index-page{padding:35px 30px 30px}.index-page:focus{outline:none}.index-header{display:flex;align-items:flex-end;justify-content:space-between;gap:15px;padding:0 0 23px}.index-header h2{font-size:25px;line-height:1.5;font-weight:400;letter-spacing:.1em;margin:10px 0 0}.page-number{font-family:Georgia,PrologueSong,serif;font-size:12px;color:#9c8b64;white-space:nowrap;margin-bottom:5px}.opening-list{border-top:1px solid #766c625c}.opening-entry{display:grid;grid-template-columns:31px minmax(0,1fr);column-gap:17px;position:relative;padding:24px 0 21px;border-bottom:1px solid #aca28d4d}.entry-number{grid-column:1;grid-row:1/4;align-self:start;padding:6px 0 18px;border-bottom:2px solid #45475c;font-family:Georgia,\"Times New Roman\",serif;font-size:15px;font-style:italic;color:#97917d}.entry-heading{grid-column:2;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;min-width:0}.entry-title{font-size:23px;line-height:1.5;font-weight:400;letter-spacing:.06em;margin:0;overflow-wrap:anywhere}.entry-route{font-size:10px;letter-spacing:.08em;color:#9a8864;overflow-wrap:anywhere}.entry-summary{grid-column:2;margin:12px 0 8px;font-size:14px;line-height:1.95;color:#70685c;overflow-wrap:anywhere}.entry-jump{grid-column:2;justify-self:end;display:flex;gap:18px;align-items:center;min-height:44px;padding:4px 0 4px 12px;background:none;border:0;color:#49485d;font-size:12px}.entry-jump span{font-family:Georgia,serif;font-size:23px}.entry-jump:hover{color:#968260}.entry-empty{padding:30px 0;color:var(--muted);text-align:center}.work-credits{margin:0 0 22px;padding:0 0 18px;border-bottom:1px solid var(--line);color:#847963;font-size:12px;line-height:1.8}.work-credits>div{display:grid;grid-template-columns:66px minmax(0,1fr);gap:12px;margin:6px 0}.work-credits>div:first-child{margin-top:0}.work-credits>div:last-child{margin-bottom:0}.work-credits dt{color:#a0947c;font-size:11px}.work-credits dd{margin:0;overflow-wrap:anywhere}.index-tail{text-align:right;padding-top:25px;font-family:Georgia,serif;letter-spacing:.25em;font-size:10px;color:#a69779}.petal-separator{width:52px;height:1px;background:var(--line);display:block;margin:24px auto}\n.sample-caption{margin:16px 12px;text-align:center;font-size:11px;line-height:1.8;color:#736f63}.sample-editor{margin:0 12px;background:#f5f2e8;border:1px solid #bdb6a4;border-radius:4px;font-family:system-ui,sans-serif;color:#4b4852}.sample-editor summary{padding: