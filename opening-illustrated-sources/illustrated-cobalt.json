    "<article class=\"opening-entry zoh-entry\" data-entry=\"___JIUYI_INDEX___\"><a href=\"#\" class=\"entry-link zoh-jump\" aria-label=\"___JIUYI_ENTRY_title___\"><div class=\"entry-top\"><span class=\"entry-number\">___JIUYI_NUMBER___</span><span class=\"entry-route\" data-entry-field=\"route\">___JIUYI_ENTRY_route___</span></div><h3 data-entry-field=\"title\">___JIUYI_ENTRY_title___</h3><p class=\"entry-summary\" data-entry-field=\"summary\">___JIUYI_ENTRY_summary___</p><span class=\"entry-bottom\"><span data-entry-status=\"\">翻开</span><span class=\"arrow\" aria-hidden=\"true\">↗</span></span></a></article>"
  ],
  "behavior": "(function editionRuntime(state, theme, editionName, resolveRoute) {\n    const app = document.querySelector('[data-edition]');\n    const views = [...document.querySelectorAll('[data-view]')];\n    const seen = new Set();\n    const positions = new Map();\n    let route = {view:theme === 'cobalt' ? 'pages' : 'cover', index:null};\n    const routeKey = current => current.view === 'reader' ? 'reader/'+current.index : current.view;\n    let previousKey = routeKey(resolveRoute(window.location.hash, state.entries.length, theme));\n    let openTimer = null;\n    const setText = (selector, value) => document.querySelectorAll(selector).forEach(node => {node.textContent=value;});\n\n    function cancelTransition() {\n        if (openTimer !== null) window.clearTimeout(openTimer);\n        openTimer = null;\n        app.classList.remove('is-opening');\n    }\n    function fillReader(index) {\n        const entry = state.entries[index];\n        if (!entry) return;\n        setText('[data-reader-title]', entry.title || '未命名开场');\n        setText('[data-reader-route]', entry.route || '未分类');\n        setText('[data-reader-number]', String(index+1).padStart(2,'0'));\n        setText('[data-reader-text]', entry.previewText || entry.summary || '暂无开场内容');\n        const next = document.querySelector('[data-next-opening]');\n        next.hidden = index+1 >= state.entries.length;\n        if (next.hidden) next.removeAttribute('href');\n        else next.setAttribute('href', '#opening/'+(index+1));\n    }\n    function renderRoute(initial=false) {\n        cancelTransition();\n        const hash = window.location.hash || '#home';\n        positions.set(previousKey, window.scrollY);\n        const previous = route;\n        route = resolveRoute(hash, state.entries.length, theme);\n        views.forEach(node => {node.hidden = node.dataset.view !== route.view;});\n        \n        if (route.view === 'reader') {\n            seen.add(route.index);\n            fillReader(route.index);\n            setText('[data-read-count]', String(seen.size).padStart(2,'0'));\n            document.querySelectorAll('[data-entry]').forEach(node => {\n                const isSeen = seen.has(Number(node.dataset.entry));\n                node.classList.toggle('was-viewed', isSeen);\n                node.querySelector('[data-entry-status]').textContent = isSeen ? '再读一遍' : '翻开';\n            });\n        }\n        const pageTitle = route.view === 'reader' ? state.entries[route.index].title || '未命名开场' : state.title || '开场白';\n        document.title = pageTitle+' · '+editionName;\n        if (!initial) {\n            const active = views.find(node => node.dataset.view === route.view);\n            let target = active.querySelector('[data-page-heading]');\n            if (route.view === 'pages' && previous.view === 'reader') {\n                target = [...active.querySelectorAll('[data-opening-index]')].find(node => Number(node.dataset.openingIndex) === previous.index) || target;\n            }\n            if (route.view === 'cover') target = active.querySelector('[data-open-cover]') || target;\n            target?.focus({preventScroll:true});\n            const returning = route.view === 'cover' || route.view === 'pages' && previous.view === 'reader';\n            window.scrollTo({top:returning ? positions.get(routeKey(route)) || 0 : 0, behavior:'instant'});\n        }\n        previousKey = routeKey(route);\n    }\n    document.querySelectorAll('[data-open-cover]').forEach(link => link.addEventListener('click', event => {\n        if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || route.view !== 'cover') return;\n        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;\n        event.preventDefault();\n        if (openTimer !== null) return;\n        app.classList.add('is-opening');\n        openTimer = window.setTimeout(() => {\n            openTimer = null;\n            window.location.hash = 'pages';\n        }, theme === 'flight' ? 680 : 560);\n    }));\n    window.addEventListener('hashchange', () => renderRoute());\n    document.addEventListener('keydown', event => {\n        if (event.key !== 'Escape' || /INPUT|TEXTAREA|SELECT/.test(event.target.tagName) || event.target.isContentEditable) return;\n        if (openTimer !== null) {cancelTransition();return;}\n        if (route.view === 'reader') window.location.hash = 'pages';\n        else if (route.view === 'pages' && theme !== 'cobalt') window.location.hash = 'home';\n    });\n    document.querySelectorAll('[data-edit-home]').forEach(input => input.addEventListener('input', () => {\n        const key=input.dataset.editHome;\n        if (!Object.hasOwn(state,key) || key==='entries') return;\n        state[key]=input.value;\n        document.querySelectorAll('[data-home]').forEach(node => {\n            if (node.dataset.home!==key) return;\n            node.textContent=input.value;\n            if (key==='title') node.classList.toggle('is-long',Array.from(input.value).length>6);\n        });\n        if (key==='title' && route.view!=='reader') document.title=(input.value||'开场白')+' · '+editionName;\n    }));\n    document.querySelectorAll('[data-edit-entry]').forEach(input => input.addEventListener('input', () => {\n        const index=Number(input.dataset.editEntry), key=input.dataset.editKey;\n        const entry=state.entries[index];\n        if (!entry || !['title','route','summary','previewText'].includes(key)) return;\n        entry[key]=input.value;\n        document.querySelectorAll('[data-entry]').forEach(node => {\n            if(Number(node.dataset.entry)!==index) return;\n            node.querySelectorAll('[data-entry-field]').forEach(field => {if(field.dataset.entryField===key)field.textContent=input.value;});\n            if(key==='title')node.querySelector('[data-opening-index]').setAttribute('aria-label','预览开场：'+input.value);\n        });\n        if (route.view==='reader' && route.index===index) {\n            fillReader(index);\n            if(key==='title')document.title=(input.value||'未命名开场')+' · '+editionName;\n        }\n    }));\n    renderRoute(true);\n})(___JIUYI_STATE___,\"cobalt\",\"蓝墨来信\",function resolveEditionRoute(hash, count, theme) {\n    const path = String(hash || '').replace(/^#/, '');\n    const match = /^opening\\/(0|[1-9]\\d*)$/.exec(path);\n    if (match && Number(match[1]) < count) return {view:'reader', index:Number(match[1])};\n    if (path === 'pages' || theme === 'cobalt') return {view:'pages', index:null};\n    return {view:'cover', index:null};\n});\n"
}
